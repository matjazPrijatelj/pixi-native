# Dependencies and package-manager state
node_modules/
.pnpm-store/

# Generated build output
build/

# Coverage and temporary caches
coverage/
.cache/
.tmp/
tmp/

# Environment and local secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
bun-debug.log*

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# Operating-system metadata
.DS_Store
Thumbs.db

# Native addon build output
native/**/target/
native/**/build/
native/**/dawn/
native/**/depot_tools/

# Keep the Linux x64 prebuilt addon; ignore any other generated dist files
native/**/dist/
!native/gpu/dist/
!native/gpu/dist/dawn.node

# Crash dumps
core
core.*
