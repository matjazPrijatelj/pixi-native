PIXI_NODE_DEBUG=0
AUTOTOGGLE_INTERVAL=15
# Opt-in diagnostic workaround for Pixi's private WebGPU bind-group cache.
PIXI_NATIVE_WEBGPU_BIND_GROUP_CACHE_RESET=0
# MEMORY_REPORT_EMAIL=you@example.com
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFMPEG_VAAPI_DEVICE=/dev/dri/renderD128

# Local-only RTP test scene [7]. Put authenticated URLs in .env, never here.
RTP_TEST_URL_1=
RTP_TEST_URL_2=
RTP_TEST_LOCAL_ADDRESS=
RTP_TEST_WIDTH=1920
RTP_TEST_HEIGHT=1080
RTP_TEST_FPS=25
RTP_TEST_EXTRA_INPUT_ARGS_JSON=[]
