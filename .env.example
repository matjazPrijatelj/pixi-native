PIXI_NODE_DEBUG=0
# Renderer type webgpu or webgl
PIXI_RENDERER=webgpu
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFMPEG_VAAPI_DEVICE=/dev/dri/renderD128

# Local-only RTP test scene [7]. Put authenticated URLs in .env, never here.
RTP_TEST_URL_1=
RTP_TEST_URL_2=
RTP_TEST_LOCAL_ADDRESS=
RTP_TEST_WIDTH=1920
RTP_TEST_HEIGHT=1080
RTP_TEST_FPS=25
RTP_TEST_EXTRA_INPUT_ARGS_JSON=[]
