{
  "name": "@pixi-native/core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "HISTORY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./audio": "./src/audio/index.ts",
    "./files": "./src/files.ts",
    "./runtime": "./src/runtime.ts",
    "./canvas": "./src/canvas.ts",
    "./application/*.js": "./src/application/*.ts",
    "./audio/*.js": "./src/audio/*.ts",
    "./canvas/*.js": "./src/canvas/*.ts",
    "./renderers/*.js": "./src/renderers/*.ts",
    "./runtime/*.js": "./src/runtime/*.ts",
    "./video/*.js": "./src/video/*.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.8",
    "native-gles": "0.6.1",
    "webgl-node": "1.5.1"
  },
  "peerDependencies": {
    "@matjash/pixi-native-linux-x64": "~0.2.0",
    "@matjash/pixi-native-win32-x64": "~0.2.0"
  },
  "peerDependenciesMeta": {
    "@matjash/pixi-native-linux-x64": {
      "optional": true
    },
    "@matjash/pixi-native-win32-x64": {
      "optional": true
    }
  },
  "devDependencies": {
    "@matjash/pixi-native-linux-x64": "workspace:*",
    "@matjash/pixi-native-win32-x64": "workspace:*"
  }
}
