+class PresentWaitWorker : public Napi::AsyncWorker {
+  public:
+    PresentWaitWorker(Napi::Env env, void* nativeWindow)
+        : Napi::AsyncWorker(env), deferred(Napi::Promise::Deferred::New(env)),
+          nativeWindow(nativeWindow) {}
+
+    void Execute() override {
+#if defined(_WIN32)
+        signaled = dawn::native::d3d::WaitForWindowFrame(nativeWindow, 1000);
+#endif
+    }
+
+    void OnOK() override {
+        deferred.Resolve(Napi::Boolean::New(Env(), signaled));
+    }
+
+    Napi::Promise Promise() const { return deferred.Promise(); }
+
+  private:
+    Napi::Promise::Deferred deferred;
+    void* nativeWindow;
+    bool signaled = false;
+};
