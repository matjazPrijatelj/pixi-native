+bool WaitForWindowFrame(void* window, uint32_t timeoutMilliseconds) {
+    HANDLE waitHandle = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(gFrameLatencyMutex);
+        auto it = gFrameLatencyHandles.find(window);
+        if (it == gFrameLatencyHandles.end()) {
+            return false;
+        }
+        if (!DuplicateHandle(GetCurrentProcess(), it->second, GetCurrentProcess(), &waitHandle,
+                             SYNCHRONIZE, FALSE, 0)) {
+            return false;
+        }
+    }
+
+    DWORD result = WaitForSingleObject(waitHandle, timeoutMilliseconds);
+    CloseHandle(waitHandle);
+    return result == WAIT_OBJECT_0;
+}
 
