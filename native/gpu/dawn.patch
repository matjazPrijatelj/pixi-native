+void SwapChain::RegisterFrameLatencyHandle() {
+    UnregisterFrameLatencyHandle();
+    if ((mConfig.swapChainFlags & DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT) == 0 ||
+        GetSurface()->GetType() != Surface::Type::WindowsHWND) {
+        return;
+    }
+
+    ComPtr<IDXGISwapChain2> swapChain2;
+    if (FAILED(mDXGISwapChain.As(&swapChain2)) ||
+        FAILED(swapChain2->SetMaximumFrameLatency(1))) {
+        return;
+    }
+    HANDLE handle = swapChain2->GetFrameLatencyWaitableObject();
+    if (handle == nullptr) {
+        return;
+    }
+
+    mFrameLatencyHandle = handle;
+    mFrameLatencyWindow = GetSurface()->GetHWND();
+    std::lock_guard<std::mutex> lock(gFrameLatencyMutex);
+    gFrameLatencyHandles[mFrameLatencyWindow] = mFrameLatencyHandle;
+}
+
+void SwapChain::UnregisterFrameLatencyHandle() {
+    if (mFrameLatencyHandle == nullptr) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(gFrameLatencyMutex);
+        auto it = gFrameLatencyHandles.find(mFrameLatencyWindow);
+        if (it != gFrameLatencyHandles.end() && it->second == mFrameLatencyHandle) {
+            gFrameLatencyHandles.erase(it);
+        }
+    }
+    CloseHandle(mFrameLatencyHandle);
+    mFrameLatencyHandle = nullptr;
+    mFrameLatencyWindow = nullptr;
+}
