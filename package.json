    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@kmamal/sdl": "0.11.13",
    "@napi-rs/canvas": "1.0.8",
    "gsap": "^3.15.0",
    "pixi.js": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
