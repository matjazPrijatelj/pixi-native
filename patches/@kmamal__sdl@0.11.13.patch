+#include <X11/extensions/Xrender.h>
+#include <X11/Xatom.h>
+
+// SDL2 reads the visual hint during window creation. Restore it afterwards so
+// transparent and opaque windows can coexist without inheriting each other's state.
+class TransparentVisual {
+	std::string previous;
+	bool hadPrevious;
+public:
+	bool enabled = false;
+	explicit TransparentVisual(bool requested) {
+		const char *hint = SDL_GetHint(SDL_HINT_VIDEO_X11_WINDOW_VISUALID);
+		hadPrevious = hint != nullptr;
+		if (hint) previous = hint;
+		if (!requested) return;
+		Display *display = XOpenDisplay(nullptr);
+		if (!display) return;
+		const int screen = DefaultScreen(display);
+		const std::string selection = "_NET_WM_CM_S" + std::to_string(screen);
+		const Atom compositor = XInternAtom(display, selection.c_str(), True);
+		if (compositor != None && XGetSelectionOwner(display, compositor) != None) {
+			XVisualInfo match = {};
+			match.screen = screen;
+			match.depth = 32;
+			match.c_class = TrueColor;
+			int count = 0;
+			XVisualInfo *visuals = XGetVisualInfo(display,
+				VisualScreenMask | VisualDepthMask | VisualClassMask, &match, &count);
+			for (int index = 0; index < count; ++index) {
+				const XRenderPictFormat *format = XRenderFindVisualFormat(display, visuals[index].visual);
+				if (!format || format->type != PictTypeDirect || !format->direct.alphaMask) continue;
+				const std::string id = std::to_string(visuals[index].visualid);
+				enabled = SDL_SetHintWithPriority(SDL_HINT_VIDEO_X11_WINDOW_VISUALID,
+					id.c_str(), SDL_HINT_OVERRIDE) == SDL_TRUE;
+				break;
+			}
+			if (visuals) XFree(visuals);
+		}
+		XCloseDisplay(display);
+		if (!enabled) std::fprintf(stderr, "[pixi-native] X11 compositor or ARGB visual unavailable; using opaque window\n");
+	}
+	~TransparentVisual() {
+		if (hadPrevious) SDL_SetHintWithPriority(SDL_HINT_VIDEO_X11_WINDOW_VISUALID, previous.c_str(), SDL_HINT_OVERRIDE);
+		else SDL_ResetHint(SDL_HINT_VIDEO_X11_WINDOW_VISUALID);
+	}
+};
+#endif
 
 struct CachedTexture {
 	SDL_Texture *texture;
