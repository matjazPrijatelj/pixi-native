{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["bun"],
        "allowImportingTsExtensions": true
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts", "electrobun.config.ts"]
}
